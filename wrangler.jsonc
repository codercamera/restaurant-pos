{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "restaurant-pos",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "restaurant-pos",
      "database_id": "ddc33adc-12e6-41c6-b912-eeb747e15d95"
    }
  ],
  "observability": {
    "enabled": true
  }
}
